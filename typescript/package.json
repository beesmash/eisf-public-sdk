{
  "name": "@beesmash/eisf-public-sdk",
  "version": "0.1.0",
  "description": "TypeScript reference package for the EISf public reasoning canon.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/core.test.js",
    "hello": "npm run build && node dist/examples/hello-world.js"
  },
  "keywords": ["eisf", "ai", "reasoning", "decision-support"],
  "author": "Erick Lester Brown / Beesmash Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
