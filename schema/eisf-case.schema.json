{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beesmash/eisf-public-sdk/schema/eisf-case.schema.json",
  "title": "EISf Case",
  "type": "object",
  "required": ["event", "impacts", "scenarios", "adaptations", "decision"],
  "additionalProperties": true,
  "$defs": {
    "confidence": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "string", "enum": ["low", "medium", "high"]}
      ]
    },
    "stageItem": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "event": {"$ref": "#/$defs/stageItem"},
    "impacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stageItem"}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stageItem"}},
    "adaptations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stageItem"}},
    "decision": {
      "allOf": [
        {"$ref": "#/$defs/stageItem"},
        {
          "type": "object",
          "properties": {"status": {"type": "string", "enum": ["decided", "deferred"]}}
        }
      ]
    },
    "provenance": {"type": "object", "additionalProperties": true}
  }
}
